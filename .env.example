# Credentials
MONGO_URI="your_atlas_connection_string"
VOYAGE_API_KEY="your_voyage_key"
ANTHROPIC_API_KEY="your_anthropic_key"

# Tenant identity
# CLIENT_ID is used to name the database (rag_<CLIENT_ID>)
CLIENT_ID="my_tenant"
CLIENT_NAME="My Tenant"
DOCUMENT_TITLE="My Document"
DOCUMENT_DESCRIPTION="Query your corporate documents with semantic search on MongoDB Atlas."

# Optional: explicit database name (defaults to rag_<CLIENT_ID>)
# DB_NAME="rag_my_tenant"

# Optional: extra instruction appended to the system prompt
# SYSTEM_PROMPT_EXTRA="Always cite the page number when referencing information."

# Optional: comma-separated list of origins allowed to call the API in
# production deployments (defaults to the local Vite dev server).
# ALLOWED_ORIGINS="https://my-tenant.example.com"

# Resilience / retention
ANTHROPIC_TIMEOUT_SECONDS=45
ANTHROPIC_MAX_RETRIES=2
CONVERSATION_RETENTION_DAYS=30
RAG_MAX_CONCURRENCY=4
MAX_HISTORY_CHARS=48000
MAX_OUTLINE_CHARS=12000
ANTHROPIC_MAX_TOKENS=1500

# --- Resiliência / governança / tracing (todos opt-in; default = comportamento anterior) ---
# TRACE_SINK=off                  # console | phoenix | atlas. Ativo => TRACE_MASK_PII=1 é forçado (telemetry.py)
# VOYAGE_MAX_ATTEMPTS=1           # tentativas por chamada Voyage (embed/rerank); >1 liga retry só p/ 429/5xx/timeout/conexão
# LLM_STREAM_MAX_ATTEMPTS=1       # retry do Claude apenas antes do 1º token (with_retry não cobre .stream())
# STREAM_DEADLINE_S=0             # teto total da geração SSE em segundos (0 = desligado); estoura => evento error amigável
# RAG_INJECTION_FILTER=0          # 1 = descarta trechos recuperados com padrão de prompt injection (heurística, não é controle absoluto)
# RAG_REFUSE_WEAK_EVIDENCE=0      # 1 = recusa explícita sem chamar o LLM quando o melhor score do rerank-2 < piso
# RAG_MIN_RERANK_SCORE=0.6        # piso da recusa (calibrado em eval/reports/retrieval.md)
