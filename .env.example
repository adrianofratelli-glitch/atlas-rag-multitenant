# Credentials
MONGO_URI="your_atlas_connection_string"
VOYAGE_API_KEY="your_voyage_key"
ANTHROPIC_API_KEY="your_anthropic_key"

# Tenant identity
# CLIENT_ID is used to name the database (rag_<CLIENT_ID>)
CLIENT_ID="my_tenant"
CLIENT_NAME="My Tenant"
DOCUMENT_TITLE="My Document"
DOCUMENT_DESCRIPTION="Query your corporate documents with semantic search on MongoDB Atlas."

# Optional: explicit database name (defaults to rag_<CLIENT_ID>)
# DB_NAME="rag_my_tenant"

# Optional: extra instruction appended to the system prompt
# SYSTEM_PROMPT_EXTRA="Always cite the page number when referencing information."

# Optional: comma-separated list of origins allowed to call the API in
# production deployments (defaults to the local Vite dev server).
# ALLOWED_ORIGINS="https://my-tenant.example.com"

# Resilience / retention
ANTHROPIC_TIMEOUT_SECONDS=45
ANTHROPIC_MAX_RETRIES=2
CONVERSATION_RETENTION_DAYS=30
RAG_MAX_CONCURRENCY=4
MAX_HISTORY_CHARS=48000
MAX_OUTLINE_CHARS=12000
ANTHROPIC_MAX_TOKENS=1500

# --- Resiliência (ligada por padrão; a variável só ajusta ou desliga) ---
# VOYAGE_MAX_ATTEMPTS=3           # tentativas por chamada Voyage (embed/rerank) só p/ 429/5xx/timeout/conexão; 1 desliga
# LLM_STREAM_MAX_ATTEMPTS=3       # retry do Claude apenas antes do 1º token (with_retry não cobre .stream()); 1 desliga
# STREAM_DEADLINE_S=120           # teto total da geração SSE em segundos; estoura => evento error amigável; 0 desliga
# RAG_INJECTION_FILTER=1          # descarta trechos recuperados com padrão de prompt injection (heurística offline); 0 desliga
# CHECKPOINT_TTL_DAYS=30          # TTL dos checkpoints do LangGraph (padrão = CONVERSATION_RETENTION_DAYS); 0 desliga

# --- Governança / tracing (opt-in) ---
# TRACE_SINK=off                  # console | phoenix | atlas. Ativo => TRACE_MASK_PII=1 é forçado (telemetry.py)
# RAG_REFUSE_WEAK_EVIDENCE=0      # 1 = recusa explícita sem chamar o LLM quando o melhor score do rerank < piso
# RAG_MIN_RERANK_SCORE=0.65       # piso da recusa (0.65 nativo, 0.6 clássico; calibrado em eval/reports/retrieval.md)

# --- Gateway do LLM (obrigatório, sem destino implícito) ---
# Com o pacote pov-shared instalado: GROVE_BASE_URL + GROVE_API_KEY (validado por grove_client).
# Sem ele: ANTHROPIC_BASE_URL explícito + ANTHROPIC_API_KEY.
# GROVE_BASE_URL="https://your-gateway.example/anthropic"
# GROVE_API_KEY="your_gateway_key"
# ANTHROPIC_BASE_URL="https://your-gateway.example/anthropic"

# --- Reset da demo (scripts/reset_demo.py) ---
# DEMO_CORPUS="data/document.pdf,data/annex.md"   # corpus base; vazio = todo arquivo suportado em data/
# ALLOW_DEMO_DB_WRITE=1           # necessário para gravar num banco que não termina em _test

# --- Recuperação nativa no Atlas (MongoDB 9): autoEmbed + $rankFusion + $rerank num único aggregation ---
# RAG_NATIVE=0                    # 1 = ativa. Exige banco com índice autoEmbed (python setup_db_native.py)
# NATIVE_EMBED_MODEL=voyage-4
# NATIVE_RERANK_MODEL=rerank-3    # preview; exige M10+ dedicado e MongoDB 9.0+. rerank-2.5 funciona em qualquer cluster
# NATIVE_RERANK_CANDIDATES=30     # documentos enviados ao $rerank (máx. 1000)
# EMBED_MODE=                     # auto|manual; vazio = segue RAG_NATIVE (auto não embeda no cliente)
