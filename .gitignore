# Virtual environments and cache
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.DS_Store

# Environment variables — never commit
.env
.env.local
.env.bak

# Client documents and assets — sensitive data
data/*
!data/.gitkeep
assets/*
!assets/.gitkeep

# Per-client configuration (generated from the example)
client_config.json

# Editor backup files
*.save

# Local editor/IDE settings
.idea/
.vscode/

# Runtime logs from run.sh
.logs/

# Eval: ambiente separado e artefatos com trechos do documento do tenant.
# O golden e os artefatos do bench citam o documento real (nomes, trechos, respostas):
# o repositório é agnóstico de tenant, então ficam fora. eval/questions.example.json e
# eval/build_golden.py reconstroem o golden a partir do corpus em data/.
.venv-eval/
eval/questions.json
eval/golden.jsonl
bench/goldset.json
bench/results.json
bench/corpus_stats.json
bench/relatorio_pdf_vs_markdown.pdf
eval/reports/retrieval_cache.json
eval/reports/answers_*.jsonl
eval/reports/ragas_dataset.jsonl
eval/reports/ragas_dataset.jsonl
eval/reports/retrieval_dataset.jsonl
eval/reports/*.log
# Execuções etiquetadas do eval (EVAL_TAG): caches e relatórios citam o corpus
eval/reports/retrieval_cache_*.json
eval/reports/retrieval_results_*.json
eval/reports/retrieval_legacy_*.md
eval/reports/retrieval_native_*.md

# Grafo de conhecimento: cache de extração cita o corpus
.graph_cache/
eval/graph_compare_questions.json
eval/reports/graph_compare.md
eval/reports/graph_compare.jsonl
eval/reports/graph_audit.md
eval/reports/graph_audit.jsonl
eval/reports/human_review.xlsx
eval/reports/human_agreement.md
eval/reports/llm_review_*
eval/reports/codex_review_*
eval/reports/*.bak-*
eval/reports/human_review_codex.xlsx
# Eval de isolamento: corpus sintético, mas o relatório completo é por rodada (o resumo vai no README)
eval/reports/isolation_*.json
